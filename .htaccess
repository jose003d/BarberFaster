# .htaccess de PRODUCCIÓN (Hostinger). Vite lo copia a la raíz del build.
Options -Indexes
DirectoryIndex index.html index.php

# La integración Git de Hostinger deja .git/ y .gitignore en public_html:
# nunca deben abrirse desde el navegador.
RedirectMatch 404 /\.git

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar HTTPS
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # El backend PHP (erpbarber/barberfaster/backend) se atiende tal cual
  RewriteRule ^erpbarber/ - [L]

  # Archivos y carpetas que existen se sirven directamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Cualquier otra ruta es de React Router (ej. /agenda, /login)
  RewriteRule ^ index.html [L]
</IfModule>

# index.html sin caché para que cada despliegue se vea de inmediato;
# los assets llevan hash en el nombre y se pueden cachear.
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|ttf|otf|png|jpe?g|webp|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
