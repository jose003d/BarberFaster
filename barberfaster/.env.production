# Usado por "npm run build". En Hostinger (barberfaster.site) el frontend vive en
# la raíz de public_html y el backend en public_html/erpbarber/barberfaster/backend.
VITE_API_URL=/erpbarber/barberfaster/backend

# Dominios dedicados al panel SUPERADMIN (separados por coma): su raíz abre el panel.
VITE_SUPERADMIN_HOSTS=barbersuperadmin.tech,www.barbersuperadmin.tech

# Dominios públicos donde el logo del navbar abre el panel SUPERADMIN en el mismo
# dominio, sin redirigir a barbersuperadmin.tech. La raíz sigue mostrando las barberías.
VITE_SUPERADMIN_HOSTS_COMPARTIDOS=barberfaster.site,www.barberfaster.site
