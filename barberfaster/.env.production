# Usado por "npm run build". En Hostinger (barberfaster.site) el frontend vive en
# la raíz de public_html y el backend en public_html/erpbarber/barberfaster/backend.
VITE_API_URL=/erpbarber/barberfaster/backend

# Dominios donde se publica el panel SUPERADMIN (separados por coma).
VITE_SUPERADMIN_HOSTS=barbersuperadmin.tech,www.barbersuperadmin.tech
