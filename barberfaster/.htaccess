<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /erpbarber/barberfaster/

  # Serve the built app entry point for the root URL
  RewriteRule ^$ build/index.html [L]
  RewriteRule ^index\.html$ build/index.html [L]

  # Serve built assets from build/assets
  RewriteRule ^assets/(.*)$ build/assets/$1 [L]
  RewriteRule ^favicon\.svg$ build/favicon.svg [L]
  RewriteRule ^manifest\.json$ build/manifest.json [L]

  # Fallback for SPA deep links
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . build/index.html [L]
</IfModule>
