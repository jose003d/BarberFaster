# Configuración del backend de BarberFaster (formato .env).
#
# Hostinger: copia este archivo como  domains/barberfaster.site/.env
#            (la carpeta que CONTIENE a public_html, nunca dentro de ella).
# XAMPP:     cópialo como  barberfaster/backend/.env  (opcional: sin él se usa
#            root sin contraseña y la base "barberfaster").
#
# Nunca subas el .env real a Git. Usa comillas si el valor tiene espacios o #.

# --- Base de datos (hPanel > Bases de datos > MySQL) ---
DB_HOST=localhost
DB_NAME=u000000000_barberfaster
DB_USER=u000000000_usuario
DB_PASS="cambia-esta-contrasena"

# --- Sitio ---
# Ruta pública del sitio. Déjala vacía para detectarla sola.
APP_BASE_PATH=
APP_URL=https://barberfaster.site

# Dominios donde se permite el login SUPERADMIN (separados por coma).
# Vacío = solo desde este equipo (XAMPP).
SUPERADMIN_HOSTS=barbersuperadmin.tech,www.barbersuperadmin.tech,barberfaster.site,www.barberfaster.site

# --- Correo (recuperación de contraseña y aprobaciones) ---
PASSWORD_RESET_FROM=no-reply@barberfaster.site
# SMTP (hPanel > Correos). Sin SMTP_HOST se usa mail() de PHP.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@barberfaster.site
SMTP_PASS=

# --- Pagos en línea (Wompi) ---
# Cada barbería pega las llaves de SU cuenta de Wompi en el panel
# (Pagos en línea), así el dinero le llega directo a ella. Aquí solo van:
# Clave maestra para cifrar esas llaves en la base de datos (32 bytes en base64).
# Genérala una sola vez con:  php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Si la pierdes o la cambias, cada barbería debe volver a pegar sus llaves.
PAGOS_CLAVE_CIFRADO=
# URL pública de la aplicación que termina en /reservar.
WOMPI_REDIRECT_URL=https://barberfaster.site/reservar

# --- Wuapi (códigos de verificación por WhatsApp) ---
WUAPI_ACCOUNT_ID=
WUAPI_API_KEY=

# --- Pusher Channels (agenda del barbero en vivo por WebSocket) ---
# Crea una app gratuita "Channels" en https://dashboard.pusher.com y copia sus
# datos de "App Keys". Si se dejan vacíos, la agenda se actualiza cada 15 segundos.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=us2
